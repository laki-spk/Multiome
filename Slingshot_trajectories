# Get pseudotime matrix
pt <- slingPseudotime(CM_sce)

CM_subset$lineage <- apply(pt, 1, function(x) {
  if (!is.na(x[1]) & is.na(x[2])) {
    return("Lineage2")  # TAC (A4T)
  } else if (is.na(x[1]) & !is.na(x[2])) {
    return("Lineage1")  # Aging (D28)
  } else if (!is.na(x[1]) & !is.na(x[2])) {
    return("Shared")
  } else {
    return(NA)
  }
})

CM_subset <- CM_subset[, CM_subset$lineage != "Shared"]

