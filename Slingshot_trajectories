library(tradeSeq)
# Extract aligned counts from the filtered Seurat object
counts <- as.matrix(GetAssayData(CM_subset, assay = "RNA", slot = "counts"))

# Extract pseudotime and cell weights from Slingshot result on filtered SCE
pseudotime <- slingPseudotime(CM_sce)
cellWeights <- slingCurveWeights(CM_sce)

# Optional: double-check dimensions match
stopifnot(identical(rownames(pseudotime), colnames(counts)))

# Identify cells with valid pseudotime in *any* lineage
valid_cells <- rowSums(is.na(pseudotime)) < ncol(pseudotime)

# Subset all inputs
counts_filtered <- counts[, valid_cells]
pseudotime_filtered <- pseudotime[valid_cells, ]
cellWeights_filtered <- cellWeights[valid_cells, ]

# Double-check dimensions match
stopifnot(ncol(counts_filtered) == nrow(pseudotime_filtered),
          ncol(counts_filtered) == nrow(cellWeights_filtered))

# Fit the model
sce_gam <- fitGAM(counts = counts_filtered,
                  pseudotime = pseudotime_filtered,
                  cellWeights = cellWeights_filtered,
                  nknots = 6,
                  verbose = TRUE)


