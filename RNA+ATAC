##install dataset
library(Seurat)
library(Signac)
library(dplyr)
library(ggplot2)
library(stringr)
library(cowplot)
library(patchwork)
library(AnnotationHub)

## Load the annotation resource.
ah <- AnnotationHub()
## Query for available H.Sapiens EnsDb databases
query(ah, pattern = c("Homo Sapiens", "EnsDb"))
#load newest one
data <- ah[["AH116860"]]


###creat seurat object on aggreated data
## load hdf5 file from cellranger which contains both RNA and ATAC data
inputdata.10x <- Read10X_h5("./aggregated pu lab file/filtered_feature_bc_matrix.h5")


# extract RNA and ATAC data
rna_counts <- inputdata.10x$'Gene Expression'
atac_counts <- inputdata.10x$'Peaks'


# Create Seurat object
Multi <- CreateSeuratObject(counts = rna_counts)


# Now add in the ATAC-seq data
# we'll only use peaks in standard chromosomes
grange.counts <- StringToGRanges(rownames(atac_counts), sep = c(":", "-"))
grange.use <- seqnames(grange.counts) %in% standardChromosomes(grange.counts)
atac_counts <- atac_counts[as.vector(grange.use), ]
annotations <- GetGRangesFromEnsDb(ensdb = data)
seqlevels(annotations) <- paste0('chr', seqlevels(annotations))
#seqlevelsStyle(annotations) <- 'UCSC'
genome(annotations) <- "hg38"


######## use tsv.gz create a new fragment and load to the existing seurat object. 
fragments <- CreateFragmentObject(path = "./aggregated pu lab file/atac_fragments.tsv.gz", cells = colnames(Multi), validate.fragments = TRUE)

chrom_assay <- CreateChromatinAssay(
  counts = atac_counts,
  sep = c(":", "-"),
  genome = 'hg38',
  fragments = fragments,
  min.cells = 10,
  annotation = annotations
)
Multi[["ATAC"]] <- chrom_assay

## QC
#Apply scrublet scores
scrub <- read.csv('./aggregated pu lab file/scrublet_output_table.csv')
Multi@meta.data$scrub_score <- scrub$doublet_score
Multi@meta.data$Predicted_doublets <- ifelse(Multi@meta.data$scrub_score > 0.26, "Doublet","Singlet" ) 
Valid.Cells <- rownames(Multi@meta.data[Multi@meta.data$Predicted_doublets == "Singlet",])
Multi@meta.data$Cells.to.keep <- rownames(Multi@meta.data) %in% Valid.Cells
Multi <- subset(Multi,  cells = Valid.Cells)

DefaultAssay(Multi) <- "ATAC"
Multi <- NucleosomeSignal(Multi)
Multi <- TSSEnrichment(Multi)
DensityScatter(Multi, x = 'nCount_ATAC', y = 'TSS.enrichment', log_x = TRUE, quantiles = TRUE)

DefaultAssay(Multi) <- "RNA"
mito.features <- grep(pattern = "^MT-", x = rownames(x = Multi), value = TRUE)
percent.mito <- Matrix::colSums(x = GetAssayData(object = Multi, layer = 'counts')[mito.features, ]) / Matrix::colSums(x = GetAssayData(object = Multi, layer = 'counts'))
Multi[['percent.mito']] <- percent.mito

VlnPlot(Multi, features = c("nCount_ATAC", "nCount_RNA","percent.mito", "nucleosome_signal"), ncol = 2) + NoLegend()

### data filtering
Multi <- subset(
  x = Multi,
  subset = nCount_ATAC < 1e5 &
    nCount_ATAC > 1e2 &
    nCount_RNA < 15000 &
    nCount_RNA > 300 &
    percent.mito < 0.02 &
    nucleosome_signal < 4 &
    TSS.enrichment > 1
)


save(Multi, file = "./aggregated pu lab file/Multi pre processed.RData")

#We next perform pre-processing and dimensional reduction on both assays independently, using standard approaches for RNA and ATAC-seq data.
# RNA analysis
DefaultAssay(Multi) <- "RNA"
Multi <- SCTransform(Multi, verbose = FALSE) %>% RunPCA() %>% RunUMAP(dims = 1:50, reduction.name = 'umap.rna', reduction.key = 'rnaUMAP_')

# ATAC analysis
# We exclude the first dimension as this is typically correlated with sequencing depth
DefaultAssay(Multi) <- "ATAC"
Multi <- RunTFIDF(Multi)
Multi <- FindTopFeatures(Multi, min.cutoff = 'q0')
Multi <- RunSVD(Multi)
Multi <- RunUMAP(Multi, reduction = 'lsi', dims = 1:50, reduction.name = "umap.atac", reduction.key = "atacUMAP_")
### calculate WNN
Multi <- FindMultiModalNeighbors(Multi, reduction.list = list("pca", "lsi"), dims.list = list(1:50, 2:50))
Multi <- RunUMAP(Multi, nn.name = "weighted.nn", reduction.name = "wnn.umap", reduction.key = "wnnUMAP_")
Multi <- FindClusters(Multi, graph.name = "wsnn", algorithm = 3, verbose = FALSE)
## plot clusters
p1 <- DimPlot(Multi, reduction = "umap.rna", label = TRUE, label.size = 2.5, repel = TRUE) + ggtitle("RNA")
p2 <- DimPlot(Multi, reduction = "umap.atac", label = TRUE, label.size = 2.5, repel = TRUE) + ggtitle("ATAC")
p3 <- DimPlot(Multi, reduction = "wnn.umap", label = TRUE, label.size = 2.5, repel = TRUE) + ggtitle("WNN")
p1 + p2 + p3 & NoLegend() & theme(plot.title = element_text(hjust = 0.5))

### separate samples of origin
Multi$sample <- gsub("[^1-4]","",rownames(Multi@meta.data))

### Plot samples separately
p1 <- DimPlot(Multi, reduction = "umap.rna", label = TRUE, label.size = 2.5, repel = TRUE, group.by = "sample", label.box = T) + ggtitle("RNA")
p2 <- DimPlot(Multi, reduction = "umap.atac", label = TRUE, label.size = 2.5, repel = TRUE, group.by = "sample",label.box = T) + ggtitle("ATAC")
p3 <- DimPlot(Multi, reduction = "wnn.umap", label = TRUE, label.size = 2.5, repel = TRUE, group.by = "sample",label.box = T) + ggtitle("WNN")
p1 + p2 + p3 & NoLegend() & theme(plot.title = element_text(hjust = 0.5))

