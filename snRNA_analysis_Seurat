# Load hdf5 files from CellRanger for both D and L datasets
inputdata.D <- Read10X_h5("/path/to/D/filtered_feature_bc_matrix.h5")
inputdata.L <- Read10X_h5("/path/to/L/filtered_feature_bc_matrix.h5")

# Extract RNA and ATAC data
rna_counts.D <- inputdata.D$`Gene Expression`
atac_counts.D <- inputdata.D$Peaks
rna_counts.L <- inputdata.L$`Gene Expression`
atac_counts.L <- inputdata.L$Peaks

# Create Seurat objects for D and L
D <- CreateSeuratObject(counts = rna_counts.D)
L <- CreateSeuratObject(counts = rna_counts.L)

# Add mitochondrial percentage for both D and L
D[["percent.mt"]] <- PercentageFeatureSet(D, pattern = "^mt-")
L[["percent.mt"]] <- PercentageFeatureSet(L, pattern = "^mt-")

# Visualize QC metrics for D
VlnPlot(D, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
plot1.D <- FeatureScatter(D, feature1 = "nCount_RNA", feature2 = "percent.mt")
plot2.D <- FeatureScatter(D, feature1 = "nCount_RNA", feature2 = "nFeature_RNA")
plot1.D + plot2.D
D <- subset(D, subset = nFeature_RNA > 200 & nFeature_RNA < 4000 & percent.mt < 5)

# Visualize QC metrics for L
VlnPlot(L, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
plot1.L <- FeatureScatter(L, feature1 = "nCount_RNA", feature2 = "percent.mt")
plot2.L <- FeatureScatter(L, feature1 = "nCount_RNA", feature2 = "nFeature_RNA")
plot1.L + plot2.L
L <- subset(L, subset = nFeature_RNA > 200 & nFeature_RNA < 2500 & percent.mt < 5)

# RNA analysis for D using SCTransform
D <- SCTransform(D, vars.to.regress = "percent.mt", verbose = FALSE)

# RNA analysis for L using SCTransform
L <- SCTransform(L, vars.to.regress = "percent.mt", verbose = FALSE)

# Integrate D and L into a new object 'Multi'
# First, run Harmony for batch effect correction
library(harmony)

# Run Harmony on the PCA embeddings to adjust for batch effects
D <- RunPCA(D)
L <- RunPCA(L)

# Run Harmony using the "batch" parameter to account for dataset-specific variations (e.g., "Dataset")
D <- RunHarmony(D, group.by.vars = "batch")
L <- RunHarmony(L, group.by.vars = "batch")

# Integrate D and L after Harmony correction
anchors <- FindIntegrationAnchors(object.list = list(D, L), dims = 1:30)
Multi <- IntegrateData(anchorset = anchors, dims = 1:30)

# Re-run PCA for integrated object Multi, which now includes Harmony correction
DefaultAssay(Multi) <- "RNA"
Multi <- ScaleData(Multi)
Multi <- RunPCA(Multi)

# Find neighbors and clusters for Multi
Multi <- FindNeighbors(Multi, reduction = "pca", dims = 1:30)
Multi <- FindClusters(Multi, resolution = 1)

# Calculate WNN for Multi
Multi <- FindMultiModalNeighbors(Multi, reduction.list = list("pca", "lsi"), dims.list = list(1:50, 2:50))
Multi <- RunUMAP(Multi, nn.name = "weighted.nn", reduction.name = "wnn.umap", reduction.key = "wnnUMAP_")
Multi <- FindClusters(Multi, graph.name = "wsnn", algorithm = 3, verbose = FALSE)

# Plot clusters
p1 <- DimPlot(Multi, reduction = "umap.rna", label = TRUE, label.size = 2.5, repel = TRUE) + ggtitle("RNA")
p2 <- DimPlot(Multi, reduction = "umap.atac", label = TRUE, label.size = 2.5, repel = TRUE) + ggtitle("ATAC")
p3 <- DimPlot(Multi, reduction = "wnn.umap", label = TRUE, label.size = 2.5, repel = TRUE) + ggtitle("WNN")
p1 + p2 + p3 & NoLegend() & theme(plot.title = element_text(hjust = 0.5))



