# Perform QC filtering
VlnPlot(D, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
VlnPlot(L, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
D <- subset(D, subset = nFeature_RNA > 200 & nFeature_RNA < 4000 & percent.mt < 5)
L <- subset(L, subset = nFeature_RNA > 200 & nFeature_RNA < 2500 & percent.mt < 5)
----------------------------------------------------------------------------------------------------------------------------
#Integrate objects
Merged <- merge(D, y = L)
#or if you have a list: Merged <- merge(D, y = list(N, A, O))

Merged <- RunHarmony(Merged, group.by.vars = "orig.ident")

---------------------------------------------------------------------------------------------------------------------------
Merged <- Merged %>%
   NormalizeData(verbose = FALSE) %>%
   FindVariableFeatures(method = "vst", nfeatures = 3000, verbose = FALSE) %>%
   ScaleData(verbose = FALSE, features = VariableFeatures(.)) %>%
   RunPCA(verbose = FALSE) %>%
   RunHarmony(group.by.vars = "orig.ident", plot_convergence = TRUE) %>%  # Apply Harmony
   FindNeighbors(dims = 1:10, reduction = "harmony") %>%  # Use Harmony reduction
   FindClusters(resolution = 0.5) %>%
   RunUMAP(dims = 1:10, reduction = "harmony")  # Use Harmony reduction for UMAP

saveRDS(Merged, file = "Merged.rds")

