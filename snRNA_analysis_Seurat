# Load hdf5 files from CellRanger for both D and L datasets
inputdata.D <- Read10X_h5("D:/Doa_Multiome/filtered_feature_bc_matrix.h5")
inputdata.L <- Read10X_h5("D:/filtered_feature_bc_matrix.h5")

# Extract RNA data
rna_counts.D <- inputdata.D$`Gene Expression`
rna_counts.L <- inputdata.L$`Gene Expression`

# Create Seurat objects
D <- CreateSeuratObject(counts = rna_counts.D)
L <- CreateSeuratObject(counts = rna_counts.L)

# Add mitochondrial percentage
D[["percent.mt"]] <- PercentageFeatureSet(D, pattern = "^mt-")
L[["percent.mt"]] <- PercentageFeatureSet(L, pattern = "^mt-")

# Perform QC filtering
D <- subset(D, subset = nFeature_RNA > 200 & nFeature_RNA < 4000 & percent.mt < 5)
L <- subset(L, subset = nFeature_RNA > 200 & nFeature_RNA < 2500 & percent.mt < 5)

# Normalize and identify variable features for integration
D <- NormalizeData(D)
L <- NormalizeData(L)
D <- FindVariableFeatures(D, selection.method = "vst", nfeatures = 3000)
L <- FindVariableFeatures(L, selection.method = "vst", nfeatures = 3000)

# Identify integration anchors and integrate datasets
anchors <- FindIntegrationAnchors(object.list = list(D, L), dims = 1:30)
Multi <- IntegrateData(anchorset = anchors, dims = 1:30)

# Set the default assay and run SCTransform
DefaultAssay(Multi) <- "integrated"
Multi <- SCTransform(Multi, vars.to.regress = "percent.mt", verbose = FALSE)

# Run PCA
Multi <- RunPCA(Multi)

# Run Harmony for batch correction
Multi <- RunHarmony(Multi, group.by.vars = "batch")

# Run neighbors, clusters, and UMAP
Multi <- FindNeighbors(Multi, reduction = "harmony", dims = 1:30)
Multi <- FindClusters(Multi, resolution = 1)
Multi <- RunUMAP(Multi, reduction = "harmony", dims = 1:30)

# Plot UMAP
DimPlot(Multi, reduction = "umap", label = TRUE, repel = TRUE) + ggtitle("Integrated UMAP with Harmony")

