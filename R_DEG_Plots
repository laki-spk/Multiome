  labs(title = "GO Enrichment - Upregulated Genes",
       x = "Condition",
       y = "GO Term",
       size = "Gene Count",
       color = "-log10(p.adjust)")

p_up

ggsave("GO_Upregulated_Dotplot.pdf", plot = p_up, width = 20, height = 15)

