# Required libraries
library(Seurat)
library(dplyr)
library(pheatmap)
library(ggplot2)
library(clusterProfiler)
library(tidyr)
library(tibble)

# Assuming you already have upregulated and downregulated genes, GO terms, and enriched results.
# These variables should already be available from the previous code snippets:
# - up_go_all (GO term results for upregulated genes)
# - down_go_all (GO term results for downregulated genes)
# - condition is stored in your GO terms dataframe
# Perform GO enrichment for upregulated genes using clusterProfiler
# Perform GO enrichment for upregulated genes using clusterProfiler



# Collect the enrichment results for upregulated genes
up_go_all <- as.data.frame(go_up)
up_go_all$condition <- "Upregulated"

# Collect the enrichment results for downregulated genes
down_go_all <- as.data.frame(go_down)
down_go_all$condition <- "Downregulated"

# Top GO terms for upregulated genes
top_up_terms <- up_go_all %>%
  group_by(condition) %>%
  slice_min(order_by = p.adjust, n = 5) %>%
  ungroup()

# Top GO terms for downregulated genes
top_down_terms <- down_go_all %>%
  group_by(condition) %>%
  slice_min(order_by = p.adjust, n = 5) %>%
  ungroup()

# Combine top up and down regulated terms
top_terms <- bind_rows(top_up_terms, top_down_terms)

# Extract and filter the most common GO terms across conditions
top_common_terms <- top_terms %>%
  count(Description, sort = TRUE) %>%
  slice_max(n, n = 10) %>%
  pull(Description)

# Filter for the common terms
top_shared <- top_terms %>%
  filter(Description %in% top_common_terms)

# Create the side-by-side bar plot
ggplot(top_shared, aes(x = reorder(Description, -p.adjust), 
                       y = -log10(p.adjust), 
                       fill = condition)) +
  geom_col(position = position_dodge(width = 0.8), width = 0.7) +
  coord_flip() +
  theme_minimal() +
  labs(x = NULL, 
       y = "-log10(Adjusted P-value)",
       title = "Top Shared GO Terms (Upregulated and Downregulated DEGs)",
       fill = "Condition") +
  theme(axis.text.y = element_text(size = 10),
        plot.title = element_text(size = 14, face = "bold"))

# Create the side-by-side bar plot with condition as x-axis
ggplot(top_shared, aes(x = reorder(Description, -p.adjust), 
                       y = -log10(p.adjust), 
                       fill = condition)) +
  geom_col(position = position_dodge(width = 0.8), width = 0.7) +
  coord_flip() +
  theme_minimal() +
  labs(x = NULL, 
       y = "-log10(Adjusted P-value)",
       title = "Top Shared GO Terms (Upregulated and Downregulated DEGs)",
       fill = "Condition") +
  theme(axis.text.y = element_text(size = 10),
        plot.title = element_text(size = 14, face = "bold"))

# Create a facet bar plot by condition
ggplot(top_shared, aes(x = reorder(Description, -p.adjust), 
                       y = -log10(p.adjust), 
                       fill = condition)) +
  geom_col(width = 0.7) +
  coord_flip() +
  facet_wrap(~condition, scales = "free_y") +  # Facet by condition
  theme_minimal() +
  labs(x = NULL, 
       y = "-log10(Adjusted P-value)",
       title = "Top Shared GO Terms (Upregulated and Downregulated DEGs)",
       fill = "Condition") +
  theme(axis.text.y = element_text(size = 10),
        plot.title = element_text(size = 14, face = "bold"))

# Create a stacked bar plot
ggplot(top_shared, aes(x = reorder(Description, -p.adjust), 
                       y = -log10(p.adjust), 
                       fill = condition)) +
  geom_bar(stat = "identity", position = "stack", width = 0.7) +
  coord_flip() +
  theme_minimal() +
  labs(x = NULL, 
       y = "-log10(Adjusted P-value)",
       title = "Top Shared GO Terms (Upregulated and Downregulated DEGs)",
       fill = "Condition") +
  theme(axis.text.y = element_text(size = 10),
        plot.title = element_text(size = 14, face = "bold"))

# Create a side-by-side grouped bar plot
ggplot(top_shared, aes(x = reorder(Description, -p.adjust), 
                       y = -log10(p.adjust), 
                       fill = condition)) +
  geom_bar(stat = "identity", position = position_dodge(width = 0.8), width = 0.7) +
  coord_flip() +
  theme_minimal() +
  labs(x = NULL, 
       y = "-log10(Adjusted P-value)",
       title = "Top Shared GO Terms (Upregulated and Downregulated DEGs)",
       fill = "Condition") +
  theme(axis.text.y = element_text(size = 10),
        plot.title = element_text(size = 14, face = "bold"))
