library(Seurat)
library(dplyr)
library(pheatmap)
library(ggplot2)
library(tibble)


# Load your cardiomyocyte data
cm <- readRDS("CM_cells.rds")

# Assuming your data is in a Seurat object
# First check current origin values
table(cm@meta.data$origin)

# Create condition column (with explicit factor levels if needed)
cm@meta.data <- cm@meta.data %>%
  mutate(
    condition = case_when(
      origin == "A4T" ~ "4M_TAC",
      origin == "D4" ~ "4M",
      origin == "D28" ~ "28M",
      origin == "A24" ~ "24M", 
      origin == "Neo" ~ "Neo",
      TRUE ~ origin  # fallback
    ),
    # Convert to factor with meaningful order (optional)
    condition = factor(condition, 
                       levels = c("Neo", "4M", "4M_TAC", "24M", "28M"))
  )

de_list <- list()
comparisons <- c("D28", "A4T", "Neo", "A24")

for (cond in comparisons) {
  de <- FindMarkers(cm, ident.1 = cond, ident.2 = "D4", group.by = "origin",
                    logfc.threshold = 0.25, min.pct = 0.1, only.pos = FALSE)
  de$gene <- rownames(de)
  de$comparison <- cond
  de_list[[cond]] <- de %>% filter(p_val_adj < 0.05)
}
all_degs <- bind_rows(de_list)
up_genes <- all_degs %>% filter(avg_log2FC > 0.25) %>% pull(gene) %>% unique()
down_genes <- all_degs %>% filter(avg_log2FC < 0.25) %>% pull(gene) %>% unique()
all_genes <- unique(c(up_genes, down_genes))
cm_sub <- subset(cm, subset = origin %in% c("D4", "D28", "A4T", "Neo", "A24"))
expr_mat <- GetAssayData(cm_sub, slot = "scale.data")
expr_mat <- expr_mat[intersect(all_genes, rownames(expr_mat)), ]
avg_expr <- AverageExpression(cm_sub, group.by = "origin", return.seurat = FALSE)
avg_mat <- avg_expr$RNA[rownames(expr_mat), c("Neo", "A4T", "A24", "D28", "D4")]
set.seed(123)
k <- 4  # Choose the number of clusters
km <- kmeans(avg_mat, centers = k)
row_order <- order(km$cluster)
pheatmap(avg_mat[row_order, ],
         scale = "row",
         cluster_cols = TRUE,
         cluster_rows = FALSE,  # Already clustered by kmeans
         show_rownames = FALSE,
         show_colnames = TRUE,
         annotation_row = data.frame(Cluster = as.factor(km$cluster)),
         fontsize = 10,
         main = "DEG Expression Heatmap Across Conditions")

wss <- vector()
k_max <- 10  # Test up to 10 clusters

# Calculate within-cluster sum of squares for each k
for (k in 1:k_max) {
  km_out <- kmeans(avg_mat, centers = k, nstart = 25)
  wss[k] <- km_out$tot.withinss
}

# Plot the elbow plot
plot(1:k_max, wss, type = "b", pch = 19,
     xlab = "Number of Clusters (k)",
     ylab = "Total Within-Cluster Sum of Squares",
     main = "Elbow Plot for K-means")


