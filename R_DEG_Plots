library(clusterProfiler)
library(org.Mm.eg.db)  # For mouse
library(dplyr)
library(tidyr)
library(ggplot2)

# Define up/down gene lists per condition
up_genes <- list()
down_genes <- list()

for (cond in names(de_list)) {
  df <- de_list[[cond]]
  
  up_genes[[cond]] <- df %>%
    filter(p_val_adj < 0.05, avg_log2FC > 0.25) %>%
    pull(gene)
  
  down_genes[[cond]] <- df %>%
    filter(p_val_adj < 0.05, avg_log2FC < -0.25) %>%
    pull(gene)
}

# GO enrichment function
go_enrich <- function(gene_list, ont="BP") {
  enrichGO(gene = gene_list,
           OrgDb = org.Mm.eg.db,
           keyType = "SYMBOL",
           ont = ont,
           pAdjustMethod = "BH",
           pvalueCutoff = 0.05,
           qvalueCutoff = 0.2)
}

# Run enrichment per condition
go_up <- lapply(up_genes, go_enrich)
go_down <- lapply(down_genes, go_enrich)


# Format for plotting
extract_top_terms <- function(go_list, direction, top_n = 25) {
  bind_rows(lapply(names(go_list), function(cond) {
    df <- go_list[[cond]]@result %>%
      arrange(p.adjust) %>%
      head(top_n) %>%
      mutate(condition = cond, direction = direction)
  }))
}

top_go_up <- extract_top_terms(go_up, "Up")
top_go_down <- extract_top_terms(go_down, "Down")
top_go_all <- bind_rows(top_go_up, top_go_down)

library(forcats)

top_go_all$Description <- fct_reorder(top_go_all$Description, -top_go_all$p.adjust)

ggplot(top_go_all, aes(x = condition, y = Description, size = Count, color = -log10(p.adjust))) +
  geom_point(alpha = 0.8) +
  facet_wrap(~ direction, scales = "free_y") +
  scale_color_viridis_c() +
  theme_bw(base_size = 12) +
  labs(title = "GO Enrichment of DEGs",
       x = "Condition",
       y = "GO Term",
       size = "Gene Count",
       color = "-log10(p.adjust)")

# Separate the data
top_go_up_only <- top_go_all %>% filter(direction == "Up")
top_go_down_only <- top_go_all %>% filter(direction == "Down")

top_go_up_only$Description <- fct_reorder(top_go_up_only$Description, -top_go_up_only$p.adjust)

p_up <- ggplot(top_go_up_only, aes(x = condition, y = Description, size = Count, color = -log10(p.adjust))) +
