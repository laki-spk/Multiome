library(clusterProfiler)
library(org.Mm.eg.db)

# Filter genes
sig_up_TAC <- rownames(de_TAC[de_TAC$p_val_adj < 0.05 & de_TAC$avg_log2FC > 1, ])
sig_down_TAC <- rownames(de_TAC[de_TAC$p_val_adj < 0.05 & de_TAC$avg_log2FC > -1, ])
# Map gene symbols to Entrez IDs (required for enrichGO)
entrez_up_TAC <- bitr(sig_up_TAC, fromType = "SYMBOL", 
                      toType = "ENTREZID", OrgDb = org.Mm.eg.db)
entrez_down_TAC <- bitr(sig_down_TAC, fromType = "SYMBOL", 
                      toType = "ENTREZID", OrgDb = org.Mm.eg.db)
# Run GO enrichment (Biological Process)
ego_up_TAC <- enrichGO(gene = entrez_up_TAC$ENTREZID,
                       OrgDb = org.Mm.eg.db,
                       ont = "BP",
                       pAdjustMethod = "BH",
                       qvalueCutoff = 0.05,
                       readable = TRUE)
ego_down_TAC <- enrichGO(gene = entrez_down_TAC$ENTREZID,
                       OrgDb = org.Mm.eg.db,
                       ont = "BP",
                       pAdjustMethod = "BH",
                       qvalueCutoff = 0.05,
                       readable = TRUE)                       

barplot(ego_up_TAC, showCategory = 10, title = "GO terms - Upregulated in TAC vs 4M")
barplot(ego_down_TAC, showCategory = 10, title = "GO terms - Downregulated in TAC vs 4M")

