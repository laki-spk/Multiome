A4T_cells <- subset(CM_cells, subset = origin == "A4T")

# Use log-normalized values
avg_D4 <- AverageExpression(D4_cells, assays = "RNA", slot = "data")$RNA
avg_D28 <- AverageExpression(D28_cells, assays = "RNA", slot = "data")$RNA
avg_A4T <- AverageExpression(A4T_cells, assays = "RNA", slot = "data")$RNA

# Merge and compute log2 fold changes (adding small value to avoid log(0))
avg_expr <- data.frame(
  gene = rownames(avg_D4),
  D4 = avg_D4[,1],
  D28 = avg_D28[,1],
  A4T = avg_A4T[,1]
)

avg_expr$logFC_D28_vs_D4 <- log2(avg_expr$D28 + 1e-6) - log2(avg_expr$D4 + 1e-6)
avg_expr$logFC_A4T_vs_D4 <- log2(avg_expr$A4T + 1e-6) - log2(avg_expr$D4 + 1e-6)

cor_D28 <- cor(avg_expr$logFC_D28_vs_D4, log2(avg_expr$D4 + 1e-6), method = "pearson")

ggplot(avg_expr, aes(x = log2(D4 + 1e-6), y = logFC_D28_vs_D4)) +
  geom_point(alpha = 0.4) +
  geom_smooth(method = "lm", color = "red") +
  ggtitle(paste("D28 vs D4 logFC | Pearson r =", round(cor_D28, 3))) +
  xlab("log2(D4 Expression)") +
  ylab("log2FC D28 vs D4") +
  theme_minimal()

