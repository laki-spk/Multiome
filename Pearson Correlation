library(Seurat)
library(edgeR)
library(ggplot2)
library(ggrepel)
library(reshape2)

## Step 2: Load Seurat Object and Extract Counts
CM_cells <- readRDS("CM_cells.rds")

# Filter only the origins of interest
CM_subset <- subset(CM_cells, subset = origin %in% c("Neo", "D4", "D28", "A4T"))

# Extract raw counts and metadata
counts <- GetAssayData(CM_subset, slot = "counts")
meta <- CM_subset@meta.data

##Step 3: Prepare EdgeR Input
# Grouping factor
group <- factor(meta$origin, levels = c("D4", "A4T", "D28", "Neo"))

# Create DGEList
dge <- DGEList(counts = counts, group = group)

# Filter lowly expressed genes
keep <- filterByExpr(dge)
dge <- dge[keep, , keep.lib.sizes=FALSE]

# Normalize
dge <- calcNormFactors(dge)


##Step 4: Differential Expression Analysis with EdgeR
design <- model.matrix(~0 + group)
colnames(design) <- levels(group)

dge <- estimateDisp(dge, design)
fit <- glmQLFit(dge, design)

# Get contrasts
contrast_D28_vs_D4 <- makeContrasts(D28 - D4, levels=design)
contrast_A4T_vs_D4 <- makeContrasts(A4T - D4, levels=design)
contrast_Neo_vs_D4 <- makeContrasts(Neo - D4, levels=design)

# Run QL tests
res_D28 <- glmQLFTest(fit, contrast = contrast_D28_vs_D4)
res_A4T <- glmQLFTest(fit, contrast = contrast_A4T_vs_D4)
res_Neo <- glmQLFTest(fit, contrast = contrast_Neo_vs_D4)

# Convert to data frames
de_D28 <- topTags(res_D28, n=Inf)$table
de_A4T <- topTags(res_A4T, n=Inf)$table
de_Neo <- topTags(res_Neo, n=Inf)$table

# Add gene column
de_D28$gene <- rownames(de_D28)
de_A4T$gene <- rownames(de_A4T)
de_Neo$gene <- rownames(de_Neo)


##Step:5 Create Pearson Correlation Plot (logFC D28 vs A4T)

# Merge on genes
merged <- merge(de_D28[, c("gene", "logFC")], 
                de_A4T[, c("gene", "logFC")], 
                by = "gene", suffixes = c("_D28", "_A4T"))

correlation <- cor(merged$logFC_D28, merged$logFC_A4T, method = "pearson")
print(paste("Pearson correlation:", round(correlation, 3)))

ggplot(merged, aes(x = logFC_A4T, y = logFC_D28)) +
  geom_point(alpha = 0.4) +
  geom_smooth(method = "lm", color = "red") +
  ggtitle(paste("Pearson correlation = ", round(correlation, 3))) +
  theme_minimal() +
  xlab("logFC A4T vs D4") +
  ylab("logFC D28 vs D4")


##Step 6: Scatter Plots of FC Comparisons

#D28 vs D4 (y-axis) vs A4T vs D4 (x-axis)
ggplot(merged, aes(x = logFC_A4T, y = logFC_D28)) +
  geom_point(alpha = 0.4) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  geom_vline(xintercept = 0, linetype = "dashed") +
  xlab("logFC A4T vs D4") +
  ylab("logFC D28 vs D4") +
  ggtitle("Scatter: D28 vs D4 vs A4T vs D4") +
  theme_minimal()

#Neo vs D4 (y-axis) vs A4T vs D4 (x-axis)
merged_neo <- merge(de_Neo[, c("gene", "logFC")],
                    de_A4T[, c("gene", "logFC")],
                    by = "gene", suffixes = c("_Neo", "_A4T"))

ggplot(merged_neo, aes(x = logFC_A4T, y = logFC_Neo)) +
  geom_point(alpha = 0.4) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  geom_vline(xintercept = 0, linetype = "dashed") +
  xlab("logFC A4T vs D4") +
  ylab("logFC Neo vs D4") +
  ggtitle("Scatter: Neo vs D4 vs A4T vs D4") +
  theme_minimal()

#Highlight Top Up/Downregulated Genes
merged$label <- ifelse((abs(merged$logFC_D28) > 0.25 & abs(merged$logFC_A4T) > 0.25), merged$gene, NA)

ggplot(merged, aes(x = logFC_A4T, y = logFC_D28)) +
  geom_point(alpha = 0.4) +
  geom_text_repel(aes(label = label), size = 3) +
  xlab("logFC A4T vs D4") +
  ylab("logFC D28 vs D4") +
  ggtitle("Labeled Scatter Plot") +
  theme_minimal()


plot_volcano <- function(df, title) {
  df$threshold <- "Not Significant"
  df$threshold[df$FDR < 0.05 & df$logFC > 0.25] <- "Upregulated"
  df$threshold[df$FDR < 0.05 & df$logFC < -0.25] <- "Downregulated"
  
  ggplot(df, aes(x = logFC, y = -log10(FDR), color = threshold)) +
    geom_point(alpha = 0.6, size = 1.5) +
    scale_color_manual(values = c("Upregulated" = "red", 
                                  "Downregulated" = "blue", 
                                  "Not Significant" = "grey")) +
    theme_minimal() +
    xlab("log2 Fold Change") +
    ylab("-log10(FDR)") +
    ggtitle(title) +
    geom_vline(xintercept = c(-0.25, 0.25), linetype = "dashed") +
    geom_hline(yintercept = -log10(0.05), linetype = "dashed")
}

plot_volcano(de_D28, "Volcano Plot: D28 vs D4")
plot_volcano(de_A4T, "Volcano Plot: A4T vs D4")
plot_volcano(de_Neo, "Volcano Plot: Neo vs D4")

library(ggrepel)

plot_volcano_labeled <- function(df, title, top_n = 10, ylimit = 500) {
  df$threshold <- "Not Significant"
  df$threshold[df$FDR < 0.05 & df$logFC > 0.25] <- "Upregulated"
  df$threshold[df$FDR < 0.05 & df$logFC < -0.25] <- "Downregulated"
  
  df$label <- NA
  top_genes <- rbind(
    head(df[order(df$logFC, decreasing = TRUE) & df$FDR < 0.05, ], top_n),
    head(df[order(df$logFC, decreasing = FALSE) & df$FDR < 0.05, ], top_n)
  )
  df$label[match(top_genes$gene, df$gene)] <- top_genes$gene
  
  ggplot(df, aes(x = logFC, y = -log10(FDR), color = threshold)) +
    geom_point(alpha = 0.6, size = 1.5) +
    scale_color_manual(values = c("Upregulated" = "red", 
                                  "Downregulated" = "blue", 
                                  "Not Significant" = "grey")) +
    geom_text_repel(aes(label = label), max.overlaps = Inf, size = 3) +
    theme_minimal() +
    xlab("log2 Fold Change") +
    ylab("-log10(FDR)") +
    ggtitle(title) +
    geom_vline(xintercept = c(-0.25, 0.25), linetype = "dashed") +
    geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
    coord_cartesian(ylim = c(0, ylimit))
}


